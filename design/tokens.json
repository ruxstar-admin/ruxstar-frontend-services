{
  "about": "Ruxstar design tokens for the website. The app's src/constants/theme.ts is the source: change it there first, copy the values here, then run `npm run tokens`. Sizes are px on the web and dp in the app.",
  "version": "2.0.0",
  "color": {
    "about": "Dark only, as in the app. Purple is for links, checked and active states, and focus. Primary buttons are white with dark text.",
    "bg": "#0D0C12",
    "surface": "#1A1922",
    "raised": "#24222F",
    "line": "#2C2A39",
    "ink": "#FFFFFF",
    "ink-2": "#9E9CB0",
    "ink-3": "#8A889C",
    "accent": "#B45CF2",
    "accent-soft": "#D9A0FF",
    "accent-deep": "#7C3AED",
    "action": "#FFFFFF",
    "on-action": "#0D0C12",
    "disabled": "#34323F",
    "disabled-ink": "#7A7889",
    "success": "#34C759",
    "warning": "#FFB020",
    "danger": "#FF453A",
    "danger-fill": "#D70015",
    "star": "#EADC05",
    "scrim": "rgba(0, 0, 0, 0.6)"
  },
  "logo": {
    "about": "Logo artwork only. Never used as UI colours.",
    "yellow": "#EADC05",
    "blue": "#33B4FA"
  },
  "font": {
    "body": {
      "family": "Plus Jakarta Sans",
      "fallback": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "about": "Every weight from 400 to 700, as in the app. No second font."
    }
  },
  "type": {
    "caption": { "size": 13, "line": 18, "weight": 400 },
    "small": { "size": 14, "line": 20, "weight": 400 },
    "body": { "size": 16, "line": 24, "weight": 400 },
    "title": { "size": 24, "line": 30, "weight": 600, "tracking": -0.01 },
    "headline": { "size": 32, "line": 38, "weight": 700, "tracking": -0.015 },
    "display": { "size": 52, "line": 56, "weight": 700, "tracking": -0.02 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 14, "5": 18, "6": 24, "7": 32, "8": 48, "9": 64 },
  "radius": { "control": 14, "button": 999, "card": 18, "sheet": 32, "pill": 999 },
  "size": { "touch": 44, "field": 56, "primary-button": 56, "icon": 24, "icon-stroke": 1.75 },
  "motion": {
    "duration": { "press": 120, "quick": 200, "base": 320, "slow": 600, "hero": 900 },
    "easing": {
      "out": [0.22, 1, 0.36, 1],
      "in-out": [0.65, 0, 0.35, 1],
      "spring": [0.47, 1.64, 0.41, 0.8]
    },
    "press-scale": 0.97
  }
}
