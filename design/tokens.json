{
  "about": "Ruxstar design tokens. The single source for the website and the mobile apps. Sizes are px on the web and dp in the apps. Run `npm run tokens` after editing.",
  "version": "1.1.0",
  "color": {
    "about": "Matches the mobile designs: neutral greys in light, violet-tinted blacks in dark. Violet is only for `glow`, never for controls or text.",
    "light": {
      "bg": "#F4F4F5",
      "surface": "#FFFFFF",
      "sunk": "#EFEFF2",
      "line": "#EAEAEC",
      "ink": "#0A0A0A",
      "ink-2": "#6B6B70",
      "ink-3": "#76767C",
      "on-primary": "#FFFFFF",
      "star": "#0A0A0A",
      "success": "#1E7F55",
      "warning": "#9A6A12",
      "danger": "#B4402B",
      "glow": "rgba(139, 43, 226, 0.10)",
      "scrim": "rgba(10, 10, 10, 0.5)"
    },
    "dark": {
      "bg": "#09080E",
      "surface": "#15141A",
      "sunk": "#0D0C12",
      "line": "#302F37",
      "ink": "#FFFFFF",
      "ink-2": "#B6B4C1",
      "ink-3": "#8D8B98",
      "on-primary": "#09080E",
      "star": "#EADC05",
      "success": "#5BBF8E",
      "warning": "#FFC107",
      "danger": "#E5806C",
      "glow": "rgba(139, 43, 226, 0.38)",
      "scrim": "rgba(0, 0, 0, 0.6)"
    }
  },
  "logo": {
    "about": "Logo artwork only. Never used as UI colours.",
    "yellow": "#EADC05",
    "blue": "#33B4FA"
  },
  "font": {
    "body": { "family": "Inter", "fallback": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" },
    "display": {
      "family": "Fraunces",
      "weight": 600,
      "fallback": "Georgia, \"Times New Roman\", serif",
      "about": "Headlines 32 and up only. Never body text or numbers."
    }
  },
  "type": {
    "caption": { "size": 12, "line": 16, "weight": 500, "font": "body" },
    "small": { "size": 14, "line": 20, "weight": 400, "font": "body" },
    "body": { "size": 17, "line": 26, "weight": 400, "font": "body" },
    "title": { "size": 24, "line": 30, "weight": 650, "font": "body", "tracking": -0.01 },
    "headline": { "size": 34, "line": 38, "weight": 600, "font": "display", "tracking": -0.015 },
    "display": { "size": 52, "line": 54, "weight": 600, "font": "display", "tracking": -0.015 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 14, "5": 18, "6": 24, "7": 32, "8": 48, "9": 64 },
  "radius": { "control": 10, "button": 999, "card": 18, "sheet": 22, "pill": 999 },
  "size": { "touch": 44, "primary-button": 50, "icon": 24, "icon-stroke": 1.75 },
  "motion": {
    "duration": { "press": 120, "quick": 200, "base": 320, "slow": 600, "hero": 900 },
    "easing": {
      "out": [0.22, 1, 0.36, 1],
      "in-out": [0.65, 0, 0.35, 1],
      "spring": [0.47, 1.64, 0.41, 0.8]
    },
    "press-scale": 0.97
  }
}
