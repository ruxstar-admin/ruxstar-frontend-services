# Copy to .env.local for local runs. Never commit real values.

# Where the browser calls the API. Defaults to http://localhost:8080 in dev and https://api.ruxstar.com in production builds.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Set to "on" at build time to include the /design gallery in a production build. It is always on in `npm run dev`.
DESIGN_GALLERY=
